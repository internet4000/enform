{
	"lexicon": 1,
	"id": "com.internet4000.enform.follow",
	"defs": {
		"main": {
			"type": "record",
			"description": "Follow another account's repo, or one of its collections.",
			"key": "tid",
			"record": {
				"type": "object",
				"required": ["subject", "createdAt"],
				"properties": {
					"subject": {
						"type": "string",
						"format": "did",
						"description": "The account followed."
					},
					"collection": {
						"type": "string",
						"format": "nsid",
						"description": "The collection followed. Without it, the whole repo is followed."
					},
					"createdAt": {"type": "string", "format": "datetime"}
				}
			}
		}
	}
}
