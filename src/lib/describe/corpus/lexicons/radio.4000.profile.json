{
	"id": "radio.4000.profile",
	"defs": {
		"geo": {
			"type": "object",
			"required": ["latitude", "longitude"],
			"properties": {
				"latitude": {
					"type": "string",
					"maxLength": 16
				},
				"longitude": {
					"type": "string",
					"maxLength": 16
				}
			},
			"description": "Public, coarse location of the radio (a city, not an address). Decimal degrees as strings, since lexicons have no floats."
		},
		"main": {
			"key": "literal:self",
			"type": "record",
			"record": {
				"type": "object",
				"required": ["createdAt"],
				"properties": {
					"geo": {
						"ref": "#geo",
						"type": "ref"
					},
					"name": {
						"type": "string",
						"maxLength": 640,
						"maxGraphemes": 64
					},
					"image": {
						"type": "blob",
						"accept": ["image/png", "image/jpeg", "image/webp"],
						"maxSize": 1000000
					},
					"links": {
						"type": "array",
						"items": {
							"ref": "radio.4000.defs#link",
							"type": "ref"
						},
						"maxLength": 10,
						"description": "Links to elsewhere: a website, other profiles, a shop…"
					},
					"theme": {
						"ref": "#theme",
						"type": "ref"
					},
					"r4Slug": {
						"type": "string",
						"maxLength": 128,
						"description": "Slug of the channel on radio4000.com, when imported from there."
					},
					"createdAt": {
						"type": "string",
						"format": "datetime"
					},
					"updatedAt": {
						"type": "string",
						"format": "datetime"
					},
					"description": {
						"type": "string",
						"maxLength": 20000,
						"maxGraphemes": 2000
					}
				}
			},
			"description": "The radio of an account: its name, description, image, links, location and colors. One per repo."
		},
		"theme": {
			"type": "object",
			"properties": {
				"mode": {
					"type": "string",
					"knownValues": ["auto", "light", "dark"]
				},
				"darkAccent": {
					"type": "string",
					"maxLength": 32
				},
				"lightAccent": {
					"type": "string",
					"maxLength": 32
				},
				"darkBackground": {
					"type": "string",
					"maxLength": 32
				},
				"darkForeground": {
					"type": "string",
					"maxLength": 32
				},
				"lightBackground": {
					"type": "string",
					"maxLength": 32
				},
				"lightForeground": {
					"type": "string",
					"maxLength": 32
				}
			},
			"description": "Colors of the radio, as HSL triplets like '262 83% 58%'."
		}
	},
	"lexicon": 1
}
