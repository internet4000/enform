{
	"lexicon": 1,
	"id": "example.radio.profile",
	"description": "A radio: its name, what it plays, its picture. One per account.",
	"defs": {
		"main": {
			"type": "record",
			"key": "literal:self",
			"record": {
				"type": "object",
				"required": ["name"],
				"properties": {
					"name": {
						"type": "string",
						"maxGraphemes": 64
					},
					"description": {
						"type": "string",
						"maxGraphemes": 500
					},
					"image": {
						"type": "blob",
						"accept": ["image/png", "image/jpeg"],
						"maxSize": 1000000
					},
					"createdAt": {
						"type": "string",
						"format": "datetime"
					}
				}
			}
		}
	}
}
